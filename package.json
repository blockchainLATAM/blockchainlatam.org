{
  "name": "blockchainlatam.org",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.5",
  "engines": {
    "node": "22.22.2"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "pnpm --filter @blockchainlatam/web-app dev",
    "build": "turbo run build",
    "dev:web": "pnpm --filter @blockchainlatam/web-app dev",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "typecheck": "turbo run typecheck",
    "versioning": "versioning",
    "version:sync": "versioning sync",
    "version:patch": "versioning patch --no-tag",
    "version:source": "node -p \"require('./version.production.json').version\"",
    "changelog": "versioning changelog",
    "release": "pnpm release:patch",
    "release:patch": "node scripts/release.mjs patch",
    "release:push": "node scripts/release.mjs push",
    "infra:build": "pnpm --filter @blockchainlatam/infra build",
    "infra:deploy:dev": "pnpm --filter @blockchainlatam/infra deploy:dev"
  },
  "devDependencies": {
    "@edcalderon/versioning": "^1.5.11",
    "husky": "^9.1.7",
    "prettier": "^3.6.2",
    "turbo": "^2.5.6"
  }
}
